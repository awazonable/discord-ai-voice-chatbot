# ==== 必須 ====
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ==== モデル名 ====
# 注意: 以下の既定値は設計時の「仮称」であり、実在する保証はありません。
# `npm run preflight` を実行すると、そのキーで実際に使えるモデル一覧を
# 表示した上で、ここの設定が通るかどうかを検証します。
MAIN_MODEL=gpt-5.6-sol
JUDGE_MODEL=gpt-5.6-luna

# ==== 任意 ====
# OpenAI互換エンドポイント。将来のローカルQwen(vLLM/SGLang)や、
# APIキー無しで動作確認するフェイクサーバに向ける場合に指定する。
#   例: OPENAI_BASE_URL=http://127.0.0.1:8787/v1
# OPENAI_BASE_URL=

# su-shiki.com が提供するWeb版VOICEVOX APIのキー。音声合成の検証に使う。
# 取得: https://su-shiki.com/api/ 、使い方: https://voicevox.su-shiki.com/su-shikiapis/
# ポイント消費・レート制限あり。VOICEVOX_BASE_URLが設定されていれば
# こちらは使われない。
SUSHIKI_API_KEY=

# ローカルで起動したVOICEVOXエンジンを使う場合はこちらを設定する。
# 設定されていればSUSHIKI_API_KEYより優先される。ポイント消費・レート制限
# が無く、開発中の反復に向く。
#   例: VOICEVOX_BASE_URL=http://127.0.0.1:50021
VOICEVOX_BASE_URL=

# 長期記憶(ベクトルDB)用のローカルQdrant。既定値はローカル標準ポートなので
# 通常は未設定でよい。
# QDRANT_URL=http://127.0.0.1:6333

# 長期記憶のベクトル化に使う埋め込みモデル。既定値のままでよければ未設定でよい。
# EMBEDDING_MODEL=text-embedding-3-small
