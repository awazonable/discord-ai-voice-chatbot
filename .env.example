# ==== 必須 ====
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ==== モデル名 ====
# 注意: 以下の既定値は設計時の「仮称」であり、実在する保証はありません。
# `npm run preflight` を実行すると、そのキーで実際に使えるモデル一覧を
# 表示した上で、ここの設定が通るかどうかを検証します。
MAIN_MODEL=gpt-5.6-sol
JUDGE_MODEL=gpt-5.6-luna

# ==== 任意 ====
# OpenAI互換エンドポイント。将来のローカルQwen(vLLM/SGLang)や、
# APIキー無しで動作確認するフェイクサーバに向ける場合に指定する。
#   例: OPENAI_BASE_URL=http://127.0.0.1:8787/v1
# OPENAI_BASE_URL=
